<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gjsoft.java.maven</groupId>
        <artifactId>gjs-java-maven-parent</artifactId>
        <version>1.0.0-RC.2</version>    
        <relativePath/>
    </parent>

    <groupId>org.gjsoft.maven.plugins</groupId>
    <artifactId>nar-maven-plugin</artifactId>
    <version>4.0.0-RC.1</version>
    <packaging>maven-plugin</packaging>

    <name>Native ARchive plugin for Maven</name>
    <description>This plugin compiles native code and publishes native artifacts in the form of nar files.</description>
    <url>https://github.com/GJ-Soft/nar-maven-plugin</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>GJ Soft</name>
        <url>https://github.com/GJ-Soft</url>
    </organization>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<!-- NB: People who currently take responsibility for the project. -->
		<developer>
			<id>gjs</id>
			<name>Ginés Jiménez Sánchez</name>
			<email>gjsoft@gmx.es</email>
			<organization>GJ Soft</organization>
			<roles>
				<role>Master</role>
			</roles>
			<timezone>+1</timezone>			
		</developer>
	</developers>
	<contributors>
		<!--
		NB: Version 3.X Developers
		-->	
		<contributor>
			<name>Curtis Rueden</name>
			<roles>
				<role>orignal developer</role>
			</roles>
			<properties>
				<id>ctrueden</id>
			</properties>
		</contributor>
		<contributor>
			<name>Greg Domjan</name>
			<roles>
				<role>orignal developer</role>
			</roles>
			<properties>
				<id>GregDomjan</id>
			</properties>
		</contributor>
		<!--
		NB: People who have contributed substantial code to the project.
		See also: https://github.com/maven-nar/nar-maven-plugin/graphs/contributors
		-->
		<contributor>
			<name>Mark Donszelmann</name>
			<roles>
				<role>founder</role>
			</roles>
			<properties><id>duns</id></properties>
		</contributor>
		<contributor>
			<name>Johannes Schindelin</name>
			<properties><id>dscho</id></properties>
		</contributor>
		<contributor>
			<name>Richard Kerr</name>
			<properties><id>richardkerr</id></properties>
		</contributor>
	</contributors>

	<properties>
		<!-- Project management -->
		<repository.name>nar-maven-plugin</repository.name>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<defaultGoal>install</defaultGoal>
		<pluginManagement>
		<plugins>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
				<!-- Build source artifact in addition to main artifact. -->
				<executions>
					<!--
					NB: Attach sources with jar goal, not jar-no-fork, to avoid a bug
					where the -sources JAR gets generated and deployed twice. See:
					https://issues.apache.org/jira/browse/MNG-5939
					-->
					<execution>
						<id>attach-sources</id>
						<phase>none</phase>
					</execution>
					<execution>
						<id>attach-sources-jar</id>
						<goals>
						<goal>jar</goal>
					  </goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
    </pluginManagement>
    <plugins>
		<plugin>
			<artifactId>maven-plugin-plugin</artifactId>
			<executions>
				<execution>
					<id>generate-descriptor</id>
					<goals>
						<goal>descriptor</goal>
					</goals>
				</execution>
			</executions>
		</plugin>
		<plugin>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>license-maven-plugin</artifactId>
		</plugin>
    </plugins>
  </build>

  <profiles>
		<!-- NB: This profile relaxes doclint for Java 8+. Broken HTML and dangling
			 references are still reported as errors; missing documentation is not,
			 because the vendored cpptasks sources are not fully documented. -->
		<profile>
			<id>java-8</id>
			<activation>
				<jdk>(,9)</jdk>
			</activation>
			<properties>
				<!-- additionalparam was dropped in maven-javadoc-plugin 3.0, so the old
					-Xdoclint:none it carried was being silently ignored. Since 3.0 the
					doclint parameter is driven by this property instead. -->
				<maven.javadoc.doclint>all,-missing</maven.javadoc.doclint>
			</properties>
		</profile>
		<!-- Integration tests under src/it: mvn -Prun-its verify. They are copied to
			 target/it and run against a repository of their own, target/it-repo, so
			 neither src/it nor the user's local repository gets anything written into.
			 Excluded, as in the original NAR plugin: it0021 / it0022, which only work
			 on Mac OS ( a .dylib, Objective-C ), and the ones that need tools not
			 always there ( autoconf: it0013, it0029; a JDK toolchain: it0017 ). -->
		<profile>
			<id>run-its</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-invoker-plugin</artifactId>
						<version>3.10.1</version>
						<configuration>
							<cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
							<localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
							<settingsFile>src/it/settings.xml</settingsFile>
							<setupIncludes>
								<setupInclude>it-parent/pom.xml</setupInclude>
								<setupInclude>it0007-lib-shared/pom.xml</setupInclude>
								<setupInclude>it0010-lib-static/pom.xml</setupInclude>
								<setupInclude>it0020-lib-3rdparty/pom.xml</setupInclude>
								<setupInclude>it0026-native-lib-loader/pom.xml</setupInclude>
								<setupInclude>it0026-native-lib-loader-2.3.0/pom.xml</setupInclude>
								<setupInclude>it0031-push-deps-to-lowest-order-agg/pom.xml</setupInclude>
								<setupInclude>it0034-upstream-aol1-multi-aol/pom.xml</setupInclude>
								<setupInclude>it0034-upstream-aol2-multi-aol/pom.xml</setupInclude>
								<setupInclude>it0039-includesTypes/pom.xml</setupInclude>
							</setupIncludes>
							<pomIncludes>
								<pomInclude>*/pom.xml</pomInclude>
							</pomIncludes>
							<pomExcludes>
								<pomExclude>it0013-*/**</pomExclude>
								<pomExclude>it0017-*/**</pomExclude>
								<pomExclude>it0021-*/**</pomExclude>
								<pomExclude>it0022-*/**</pomExclude>
								<pomExclude>it0029-*/**</pomExclude>
							</pomExcludes>
							<preBuildHookScript>setup</preBuildHookScript>
							<postBuildHookScript>verify</postBuildHookScript>
							<goals>
								<goal>clean</goal>
								<goal>install</goal>
							</goals>
						</configuration>
						<executions>
							<execution>
								<id>integration-test</id>
								<goals>
									<goal>install</goal>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
